/*
 * =========================================================================================
 *  MS-ENHANCER-GEN: Nextflow Configuration
 * =========================================================================================
 */

manifest {
    name            = 'ms-enhancer-gen'
    author          = 'MS Enhancer Team'
    homePage        = 'https://github.com/dralperenuysal/ms-enhancer'
    description     = 'Conditional generative pipeline for cell-type-specific cis-regulatory DNA elements'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.1'
    version         = '1.0.0'
}

// Inherit host environment variables for local/VM execution
env {
    PYTHONUNBUFFERED     = "1"
    PYTHONPATH           = "${projectDir}"
    PATH                 = "${System.getenv('PATH')}"
    CUDA_VISIBLE_DEVICES = "${System.getenv('CUDA_VISIBLE_DEVICES') ?: '0,1,2,3'}"
    LD_LIBRARY_PATH      = "${System.getenv('LD_LIBRARY_PATH') ?: ''}"
}

// Default process configuration
process {
    debug         = true   // Stream live training epochs, downloads and Enformer progress directly to console
    cpus          = 4
    memory        = 16.GB
    time          = 4.h
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    // Specific resource allocations
    withName: 'BUILD_DATASET' {
        cpus   = 4
        memory = 16.GB
        time   = 2.h
    }

    withName: 'TRAIN_MODEL' {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }

    withName: 'GENERATE_SEQUENCES' {
        cpus   = 4
        memory = 16.GB
        time   = 2.h
    }

    withName: 'EVALUATE_MAIN|EVALUATE_OCCLUSION|EVALUATE_MOTIF_ABLATION|EVALUATE_CPG_SWAP|EVALUATE_LOCUS_SURVEY' {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }

    withName: 'SELECT_CANDIDATES' {
        cpus   = 2
        memory = 8.GB
        time   = 1.h
    }

    withName: 'AUDIT_OCCLUSION|AUDIT_MOTIF_ABLATION|AUDIT_CPG_SWAP|AUDIT_LOCUS_SURVEY|AUDIT_GRAMMAR' {
        cpus   = 2
        memory = 8.GB
        time   = 1.h
    }
}

// Execution Profiles
profiles {
    // Default local profile
    standard {
        process.executor = 'local'
    }

    // Docker profile (Recommended for single-machine & GPU VM reproduction)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        process {
            container = 'dralperenuysal/ms-enhancer:latest'

            // Only training and oracle scoring need a GPU; BUILD_DATASET, SELECT_CANDIDATES
            // and the CPU-only audit scripts must not require --gpus on hosts without a GPU.
            withName: 'TRAIN_MODEL|EVALUATE_MAIN|EVALUATE_OCCLUSION|EVALUATE_MOTIF_ABLATION|EVALUATE_CPG_SWAP|EVALUATE_LOCUS_SURVEY' {
                containerOptions = '--gpus all'
            }
        }
    }

    // Singularity profile (Recommended for HPC clusters without root Docker)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'ms-enhancer.sif'
    }

    // SLURM HPC profile
    slurm {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            executor  = 'slurm'
            queue     = 'gpu'
            container = 'ms-enhancer.sif'
            withName: 'TRAIN_MODEL|GENERATE_SEQUENCES|EVALUATE_MAIN|EVALUATE_OCCLUSION|EVALUATE_MOTIF_ABLATION|EVALUATE_CPG_SWAP|EVALUATE_LOCUS_SURVEY' {
                clusterOptions = '--gres=gpu:1'
            }
        }
    }

    // AWS Batch cloud profile
    awsbatch {
        aws.region      = 'us-east-1'
        docker.enabled  = true
        process {
            executor  = 'awsbatch'
            queue     = 'gpu-queue'
            container = 'dralperenuysal/ms-enhancer:latest'
            withName: 'TRAIN_MODEL|GENERATE_SEQUENCES|EVALUATE_MAIN|EVALUATE_OCCLUSION|EVALUATE_MOTIF_ABLATION|EVALUATE_CPG_SWAP|EVALUATE_LOCUS_SURVEY' {
                accelerator = 1
            }
        }
    }
}

// Execution Reports & Traces
timeline {
    enabled   = true
    overwrite = true
    file      = "pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "pipeline_info/pipeline_dag.html"
}
